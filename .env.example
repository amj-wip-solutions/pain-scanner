# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Gemini
GEMINI_API_KEY=

# Reddit (script-app OAuth, client_credentials grant)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=PAINRADAR/0.1 by u/your_username

# Resend
RESEND_API_KEY=
BRIEF_RECIPIENT=
# Optional: override sender. Default uses Resend's onboarding sender (lands in spam without a verified domain).
# BRIEF_SENDER=PAINRADAR <painradar@yourdomain.com>

# Clustering tunables (optional overrides; defaults in packages/core/src/config.ts)
# CLUSTER_SIMILARITY_THRESHOLD=0.85
# CLUSTER_KEYWORD_OVERLAP_MIN=2
# CLUSTER_TOOL_OVERLAP_REQUIRED=true
